# Metadatos públicos leídos solo en el servidor.
# Copiar a .env.local para pruebas locales. No inventar identificadores de Git.

APP_NAME=test-nextjs
APP_VERSION=v0.1.0
GIT_BRANCH=
GIT_COMMIT=
BUILD_DATE=

# Ejecución. PORT es el puerto HTTP. BIND_HOSTNAME fuerza la interfaz de escucha
# (0.0.0.0) porque Windows y Docker ya definen HOSTNAME como nombre de máquina.

PORT=3000
BIND_HOSTNAME=0.0.0.0
